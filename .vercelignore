###########################
# Monorepo .vercelignore  #
###########################

# Keep source by default. Only ignore typical artifacts.

# Dependencies
**/node_modules

# Build outputs
**/.next
**/dist
**/build
**/.vercel
**/.turbo

# Logs
**/*.log
**/logs

# Environment files
.env
.env.local
.env.*.local
*.env

# OS/editor junk
.DS_Store
*.swp

# Keep documentation by default
